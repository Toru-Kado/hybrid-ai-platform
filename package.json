{
  "name": "hybrid-ai-platform-desktop",
  "productName": "TK-AI",
  "version": "1.1.0",
  "private": true,
  "author": "Toru Kado",
  "description": "Cross-platform desktop shell for the TK-AI assistant.",
  "main": "desktop/electron/main.cjs",
  "scripts": {
    "desktop:dev": "concurrently -k \"npm:desktop:dev:vite\" \"wait-on tcp:5173 && electron .\"",
    "desktop:dev:vite": "vite --host 127.0.0.1",
    "desktop:build": "vite build",
    "desktop:icons": "electron scripts/build_desktop_icons.cjs",
    "desktop:test": "vitest run",
    "desktop:preview": "vite preview --host 127.0.0.1",
    "desktop:bundle-python": "pip install --target desktop/python-deps -r requirements-desktop.txt --upgrade --quiet",
    "desktop:pack": "npm run desktop:bundle-python && npm run desktop:build && electron-builder --dir",
    "desktop:dist": "npm run desktop:bundle-python && npm run desktop:build && electron-builder"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.24",
    "electron-updater": "^6.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "jsdom": "^27.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.4",
    "wait-on": "^9.0.0"
  },
  "build": {
    "appId": "com.torukado.hybridai",
    "productName": "TK-AI",
    "asar": false,
    "files": [
      "app/**/*",
      "desktop/assets/**/*",
      "desktop/dist/**/*",
      "desktop/electron/**/*",
      "desktop/python-deps/**/*",
      "pyproject.toml",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "Toru-Kado",
      "repo": "hybrid-ai-platform"
    },
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "desktop/assets/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "desktop/electron/entitlements.mac.plist",
      "entitlementsInherit": "desktop/electron/entitlements.mac.plist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "desktop/assets/icon.ico",
      "cscLink": "certificates/win-certificate.p12",
      "cscKeyPassword": "${env:WINCERT_PASSWORD}",
      "verifyUpdateCodeSignature": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "icon": "desktop/assets/app-icon.png"
    },
    "afterSign": "scripts/notarize.js"
  }
}
