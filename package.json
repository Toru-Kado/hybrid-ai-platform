{
  "name": "hybrid-ai-platform-desktop",
  "productName": "TK-AI",
  "version": "0.1.0",
  "private": true,
  "author": "Toru Kado",
  "description": "Cross-platform desktop shell for the TK-AI assistant.",
  "main": "desktop/electron/main.cjs",
  "scripts": {
    "desktop:dev": "concurrently -k \"npm:desktop:dev:vite\" \"wait-on tcp:5173 && electron .\"",
    "desktop:dev:vite": "vite --host 127.0.0.1",
    "desktop:build": "vite build",
    "desktop:icons": "electron scripts/build_desktop_icons.cjs",
    "desktop:test": "vitest run",
    "desktop:preview": "vite preview --host 127.0.0.1",
    "desktop:pack": "npm run desktop:build && electron-builder --dir",
    "desktop:dist": "npm run desktop:build && electron-builder"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "jsdom": "^27.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.4",
    "wait-on": "^9.0.0"
  },
  "build": {
    "appId": "com.torukado.hybridai",
    "productName": "TK-AI",
    "asar": false,
    "files": [
      "app/**/*",
      "desktop/assets/**/*",
      "desktop/dist/**/*",
      "desktop/electron/**/*",
      "pyproject.toml",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "desktop/assets/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "desktop/assets/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility",
      "icon": "desktop/assets/app-icon.png"
    }
  }
}
