{
  "name": "hybrid-ai-platform-desktop",
  "version": "0.1.0",
  "private": true,
  "author": "Toru Kado",
  "description": "Cross-platform desktop shell for the Hybrid AI Platform assistant.",
  "main": "desktop/electron/main.cjs",
  "scripts": {
    "desktop:dev": "concurrently -k \"npm:desktop:dev:vite\" \"wait-on tcp:5173 && electron .\"",
    "desktop:dev:vite": "vite --host 127.0.0.1",
    "desktop:build": "vite build",
    "desktop:preview": "vite preview --host 127.0.0.1",
    "desktop:pack": "npm run desktop:build && electron-builder --dir",
    "desktop:dist": "npm run desktop:build && electron-builder"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "vite": "^7.0.0",
    "wait-on": "^9.0.0"
  },
  "build": {
    "appId": "com.torukado.hybridai",
    "productName": "Hybrid AI Platform",
    "asar": false,
    "files": [
      "app/**/*",
      "desktop/dist/**/*",
      "desktop/electron/**/*",
      "pyproject.toml",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    }
  }
}
