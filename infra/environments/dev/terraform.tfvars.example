aws_region = "us-east-1"
aws_profile = "hybrid-ai-dev"

project_name = "hybrid-ai-platform"
environment  = "dev"

# Optional override if you need an exact bucket name.
ai_assets_bucket_name_override = null

# Set to true only in disposable environments.
ai_assets_bucket_force_destroy = true

log_retention_days = 14

# Replace with Bedrock model IDs enabled in this AWS account and region.
# If you already have a full foundation-model ARN, that works here too.
bedrock_allowed_model_ids = [
  "anthropic.claude-3-5-sonnet-20241022-v2:0"
]

# If the app uses BEDROCK_INFERENCE_PROFILE_ARN, allow that ARN here too.
bedrock_allowed_inference_profile_arns = []

# Leave empty to trust the current AWS account, or provide a tighter allow-list.
runtime_role_trusted_principal_arns = []

tags = {
  Owner = "solo-developer"
}
