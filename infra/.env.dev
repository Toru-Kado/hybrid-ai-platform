# Development environment configuration for CDK deployment
# Source: source infra/.env.dev && cdk deploy

ENVIRONMENT_TYPE=dev
ENVIRONMENT_NAME=dev
PROJECT_NAME=hybrid-ai-platform
COMPANY_NAME=Toru Kado
ORGANIZATION_SEGMENT=toru-kado

# AWS configuration
AWS_REGION=us-east-1
AWS_PROFILE=TK-Admin
CDK_DEFAULT_REGION=us-east-1

# Development: allow destructive operations & short log retention
ASSETS_BUCKET_FORCE_DESTROY=true
LOG_RETENTION_DAYS=7

# Optional: Bedrock configuration for dev
# BEDROCK_FOUNDATION_MODEL_IDS=anthropic.claude-3-5-sonnet-20241022-v2:0
# BEDROCK_INFERENCE_PROFILE_ARNS=

# Optional: Bedrock guardrails
# BEDROCK_GUARDRAIL_ARNS=

# Optional: Runtime trusted principals (cross-account access)
# RUNTIME_TRUSTED_PRINCIPAL_ARNS=

# Optional: Local development operator user
# OPERATOR_USER_NAME=your-iam-username
# OPERATOR_ROLE_ENABLE_OBSERVABILITY_ACCESS=true
