# Production environment configuration for CDK deployment
# Source: source infra/.env.prod && cdk deploy
# ⚠️  Review all settings carefully before deploying to production.

ENVIRONMENT_TYPE=prod
ENVIRONMENT_NAME=prod
PROJECT_NAME=hybrid-ai-platform
COMPANY_NAME=Toru Kado
ORGANIZATION_SEGMENT=toru-kado

# AWS configuration
AWS_REGION=us-east-1
AWS_PROFILE=TK-Admin
CDK_DEFAULT_REGION=us-east-1

# Production: never destroy data, long log retention
ASSETS_BUCKET_FORCE_DESTROY=false
LOG_RETENTION_DAYS=90

# Required for production: Bedrock configuration
# Use inference profiles for cross-region resilience
# BEDROCK_FOUNDATION_MODEL_IDS=
BEDROCK_INFERENCE_PROFILE_ARNS=

# Recommended: Bedrock guardrails for production safety
# BEDROCK_GUARDRAIL_ARNS=

# Optional: Runtime trusted principals (cross-account access for services)
# RUNTIME_TRUSTED_PRINCIPAL_ARNS=

# Production: disable operator access (use IAM policies directly)
OPERATOR_USER_NAME=
OPERATOR_ROLE_ENABLE_OBSERVABILITY_ACCESS=false
