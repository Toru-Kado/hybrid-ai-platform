APP_ENV=dev
APP_NAME=hybrid-ai-assistant
AI_PROVIDER=bedrock
LOG_LEVEL=INFO

# Bedrock provider settings.
AWS_REGION=us-east-1
AWS_PROFILE=hybrid-ai-dev

# Use a Bedrock model ID available in your account and region.
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Optional: use an inference profile ID or ARN instead of direct model invocation.
BEDROCK_INFERENCE_PROFILE_ID=
BEDROCK_INFERENCE_PROFILE_ARN=

# Direct Anthropic provider settings.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_VERSION=2023-06-01

# Optional Bedrock guardrails.
# BEDROCK_GUARDRAIL_MODE=off omits Bedrock guardrails completely.
# BEDROCK_GUARDRAIL_MODE=user guards only the user prompt.
# BEDROCK_GUARDRAIL_MODE=all guards both the user prompt and the system prompt.
BEDROCK_GUARDRAIL_IDENTIFIER=
BEDROCK_GUARDRAIL_VERSION=
BEDROCK_GUARDRAIL_MODE=off
BEDROCK_GUARDRAIL_TRACE=false

MODEL_MAX_TOKENS=1024
MODEL_TEMPERATURE=0.2
ASSISTANT_SYSTEM_PROMPT=You are a pragmatic hybrid AI platform assistant.

# Optional: populate these from Terraform outputs for local reference.
AI_ASSETS_BUCKET_NAME=
ASSISTANT_LOG_GROUP_NAME=
