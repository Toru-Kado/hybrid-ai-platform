APP_ENV=dev
APP_NAME=hybrid-ai-assistant
LOG_LEVEL=INFO

AWS_REGION=us-east-1
AWS_PROFILE=hybrid-ai-dev

# Use a model ID available in your Bedrock account and region.
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Optional: use an inference profile ARN instead of a direct model ID.
BEDROCK_INFERENCE_PROFILE_ARN=

BEDROCK_MAX_TOKENS=1024
BEDROCK_TEMPERATURE=0.2
ASSISTANT_SYSTEM_PROMPT=You are a pragmatic hybrid AI platform assistant.

# Optional: populate these from Terraform outputs for local reference.
AI_ASSETS_BUCKET_NAME=
ASSISTANT_LOG_GROUP_NAME=
